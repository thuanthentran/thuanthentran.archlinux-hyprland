/* Spotlight look, white + black + green palette (Theme.qml in Quickshell) */
* {
    bg:      rgba(17, 18, 17, 0.94);
    bg-sel:  rgba(255, 255, 255, 0.10);
    accent:  #4ade80;
    fg:      #f4f5f4;
    fg-dim:  rgba(244, 245, 244, 0.5);
    font:    "Lexend 13";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: north;
    anchor: north;
    y-offset: 18%;
    width: 640px;
    background-color: @bg;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

mainbox { children: [inputbar, listview]; padding: 6px; }

inputbar {
    children: [prompt, entry];
    padding: 12px 14px;
    spacing: 10px;
}
prompt { text-color: @accent; }
entry { placeholder: "Spotlight Search"; placeholder-color: @fg-dim; cursor-color: @accent; }

listview {
    lines: 7;
    scrollbar: false;
    fixed-height: false;
    margin: 4px 0 0 0;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 10px;
}
element selected.normal { background-color: @bg-sel; }
element-icon { size: 28px; }
element-text { vertical-align: 0.5; }
